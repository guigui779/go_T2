{
  "builds": [
    { "src": "server.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/admin.css", "dest": "/admin.css" },
    { "src": "/admin.js", "dest": "/admin.js" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/style.css", "dest": "/style.css" },
    { "src": "/(.*)", "dest": "/server.py" }
  ]
}
